# File tham khảo chung. Khi chạy local, copy các biến BACKEND vào backend/.env.
# Frontend có mẫu riêng tại frontend/.env.example.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hanquoc_classroom
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_BASE64=

# Production: dùng 2 chuỗi ngẫu nhiên KHÁC NHAU, mỗi chuỗi >= 32 ký tự.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
SETTINGS_ENCRYPTION_KEY=change-this-to-another-long-random-secret-32-chars

REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=hq_refresh
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_DOMAIN=

# Có thể khai báo nhiều key bằng dấu phẩy. Key Admin thêm trên web sẽ được mã hóa trong MySQL.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=25000
AI_KEY_COOLDOWN_SECONDS=60
AI_PROMPT_MAX_CHARS=12000
AI_HISTORY_MAX_MESSAGES=24
AI_HISTORY_MAX_CHARS=40000
TTS_TIMEOUT_MS=12000

RATE_LIMIT_GENERAL_PER_MINUTE=1200
RATE_LIMIT_LOGIN_PER_15_MINUTES=10
RATE_LIMIT_LOGIN_IP_PER_15_MINUTES=120
RATE_LIMIT_REFRESH_PER_15_MINUTES=60
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_AI_CONCURRENT_PER_USER=2
RATE_LIMIT_TTS_PER_MINUTE=120

# 0 = không tự xóa draft/bài cũ. Khuyến nghị giữ 0 trên production.
AUTO_CLEANUP_DAYS=0
